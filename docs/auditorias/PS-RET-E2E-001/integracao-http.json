    "response": "<!DOCTYPE html>\n<html lang=\"pt-BR\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Acesso à gestão — Gestão de Processos Seletivos · Cefor/Ifes</title>\n<link rel=\"stylesheet\" href=\"/static/shared/tokens.css?v=239e9b1475d4\">\n<link rel=\"stylesheet\" href=\"/static/interface/grupos/acesso.css?v=bdbc26686f26\">\n</head>\n<body>\n\n<svg class=\"simbolos\" width=\"0\" height=\"0\" aria-hidden=\"true\" focusable=\"false\">\n  <symbol id=\"i-seta\" viewBox=\"0 0 24 24\"><path d=\"M5 12h14M13 6l6 6-6 6\"/></symbol>\n  <symbol id=\"i-voltar\" viewBox=\"0 0 24 24\"><path d=\"M19 12H5M11 18l-6-6 6-6\"/></symbol>\n  <symbol id=\"i-chevron\" viewBox=\"0 0 24 24\"><path d=\"M9 6l6 6-6 6\"/></symbol>\n  <symbol id=\"i-escudo\" viewBox=\"0 0 24 24\"><path d=\"M12 3l7 3v5c0 4.5-3 8.5-7 10-4-1.5-7-5.5-7-10V6z\"/><path d=\"M9 12l2 2 4-4\"/></symbol>\n  <symbol id=\"i-frasco\" viewBox=\"0 0 24 24\"><path d=\"M9 3h6M10 3v6l-5.2 8.7A2 2 0 0 0 6.5 21h11a2 2 0 0 0 1.7-3.3L14 9V3\"/><path d=\"M7.5 15h9\"/></symbol>\n  <symbol id=\"i-usuarios\" viewBox=\"0 0 24 24\"><circle cx=\"9\" cy=\"8\" r=\"3.5\"/><path d=\"M3 20c0-3.3 2.7-6 6-6s6 2.7 6 6\"/><path d=\"M16 4.6a3.5 3.5 0 0 1 0 6.8M21 20c0-2.6-1.6-4.8-4-5.6\"/></symbol>\n  <symbol id=\"i-camadas\" viewBox=\"0 0 24 24\"><path d=\"M12 3l9 5-9 5-9-5z\"/><path d=\"M3 13l9 5 9-5\"/></symbol>\n  <symbol id=\"i-documento\" viewBox=\"0 0 24 24\"><path d=\"M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z\"/><path d=\"M14 3v5h5M9 13h6M9 17h6\"/></symbol>\n  <symbol id=\"i-prancheta\" viewBox=\"0 0 24 24\"><rect x=\"5\" y=\"4\" width=\"14\" height=\"17\" rx=\"2\"/><path d=\"M9 4V3h6v1M9 12.5l2 2 4-4\"/></symbol>\n  <symbol id=\"i-inscricao\" viewBox=\"0 0 24 24\"><path d=\"M12 20h9\"/><path d=\"M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z\"/></symbol>\n  <symbol id=\"i-balanca\" viewBox=\"0 0 24 24\"><path d=\"M12 3v18M7 21h10M5 7h14M5 7l-3 7a3.5 3.5 0 0 0 6 0zM19 7l-3 7a3.5 3.5 0 0 0 6 0z\"/></symbol>\n  <symbol id=\"i-lista\" viewBox=\"0 0 24 24\"><path d=\"M10 6h10M10 12h10M10 18h10\"/><path d=\"M4 6h.01M4 12h.01M4 18h.01\" stroke-width=\"3\"/></symbol>\n  <symbol id=\"i-busca\" viewBox=\"0 0 24 24\"><circle cx=\"11\" cy=\"11\" r=\"7\"/><path d=\"M20 20l-3.5-3.5\"/></symbol>\n  <symbol id=\"i-externo\" viewBox=\"0 0 24 24\"><path d=\"M14 4h6v6M20 4l-9 9M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5\"/></symbol>\n  <symbol id=\"i-marca\" viewBox=\"0 0 24 24\"><path d=\"M5 7h14M5 12h10M5 17h6\"/></symbol>\n</svg>\n<a class=\"pular\" href=\"#conteudo\">Pular para o conteúdo</a>\n<div class=\"acesso\">\n  <aside class=\"produto\" aria-label=\"Sobre o sistema\">\n    <a class=\"instituicao\" href=\"/selecoes/\">\n      <span class=\"simbolo\"><svg aria-hidden=\"true\" viewBox=\"0 0 24 24\"><use href=\"#i-marca\"/></svg></span>\n      <span>Cefor · Ifes<small>Instituto Federal do Espírito Santo</small></span>\n    </a>\n    <div class=\"tese\">\n      <p class=\"sobretitulo\">GPS · Gestão de Processos Seletivos</p>\n      <p class=\"manchete\">Do edital ao resultado, a seleção inteira num só lugar.</p>\n      <p class=\"apresentacao\">Uma plataforma para organizar editais, inscrições, avaliações,\n        resultados e todas as etapas de uma seleção.</p>\n      \n      <ol class=\"ciclo\" aria-label=\"Etapas que o sistema conduz\">\n        <li><span class=\"marco-do-ciclo\"><svg class=\"i\" aria-hidden=\"true\"><use href=\"#i-documento\"/></svg></span>Edital</li>\n        <li><span class=\"marco-do-ciclo\"><svg class=\"i\" aria-hidden=\"true\"><use href=\"#i-inscricao\"/></svg></span>Inscrições</li>\n        <li><span class=\"marco-do-ciclo\"><svg class=\"i\" aria-hidden=\"true\"><use href=\"#i-prancheta\"/></svg></span>Avaliação</li>\n        <li><span class=\"marco-do-ciclo\"><svg class=\"i\" aria-hidden=\"true\"><use href=\"#i-balanca\"/></svg></span>Recursos</li>\n        <li><span class=\"marco-do-ciclo\"><svg class=\"i\" aria-hidden=\"true\"><use href=\"#i-lista\"/></svg></span>Resultado</li>\n      </ol>\n    </div>\n    <p class=\"unidade\">Centro de Referência em Formação e em Educação a Distância</p>\n  </aside>\n\n  <!-- tabindex=\"-1\": sem ele o link de salto move a rolagem mas não o foco (WCAG 2.4.1). -->\n  <main class=\"lado-do-acesso\" id=\"conteudo\" tabindex=\"-1\">\n    <div class=\"topo-do-acesso\">\n      <span class=\"selo-ambiente\">Ambiente de demonstração</span>\n      <a href=\"/selecoes/\">Portal público <svg class=\"i\" aria-hidden=\"true\"><use href=\"#i-externo\"/></svg></a>\n    </div>\n    <div class=\"centro-do-acesso\">\n      \n<div class=\"cartao-de-acesso\">\n  <span class=\"simbolo\" aria-hidden=\"true\"><svg viewBox=\"0 0 24 24\"><use href=\"#i-marca\"/></svg></span>\n  <h1>Bem-vindo à gestão</h1>\n  <p class=\"chamada\">Acesse seu ambiente de trabalho.</p>\n\n  \n  \n  \n  <a class=\"entrar\" href=\"/gestao/identificar/demonstracao?proximo=/gestao/retificacoes/d1076595-d07e-4273-9757-76ed385db46e/\" aria-describedby=\"nota-do-metodo\">\n    <svg class=\"i\" aria-hidden=\"true\"><use href=\"#i-frasco\"/></svg>Acessar ambiente de demonstração\n    <svg class=\"i seta\" aria-hidden=\"true\"><use href=\"#i-seta\"/></svg></a>\n  <p class=\"nota-do-metodo\" id=\"nota-do-metodo\">A autenticação institucional ainda não foi integrada.\n    Neste ambiente, a entrada é por identidades de demonstração, que não existem em produção.</p>\n  \n\n  <div class=\"separador\">Candidatos</div>\n  <a class=\"atalho\" href=\"/selecoes/inscricoes/\">\n    <span class=\"icone\"><svg class=\"i\" aria-hidden=\"true\"><use href=\"#i-usuarios\"/></svg></span>\n    <span><strong>Procura suas inscrições?</strong><span>Acompanhe tudo pelo portal público</span></span>\n    <svg class=\"i seta\" aria-hidden=\"true\"><use href=\"#i-seta\"/></svg>\n  </a>\n</div>\n\n    </div>\n    <footer class=\"pe-do-acesso\">\n      <span>Cefor/Ifes · Gestão de Processos Seletivos</span>\n      <span>Acesso restrito à equipe da unidade</span>\n    </footer>\n  </main>\n</div>\n\n</body>\n</html>\n",
