{"content": {"year": 2026, "title": "Edital nº 91/2026 – Curso de Pós-graduação Lato Sensu em Informática na Educação na modalidade EaD (DEMONSTRAÇÃO)", "number": "91", "stages": [{"id": "7fe1ef58-79b4-5a18-b43a-e9c64b4d6a9b", "name": "Análise documental", "forma": "DECISORIA", "order": 1, "weight": null, "eliminatory": true, "maximumScore": null, "minimumScore": null, "classificatory": false, "rotuloFavoravel": "Deferida", "scheduleEventId": "52486c4a-e326-5a6d-87d5-e0ed825a1d72", "rotuloDesfavoravel": "Indeferida", "evaluationsPerRegistration": null}], "editalId": "3fb48052-9a82-4501-9c5f-dd7391e9d0b1", "profiles": [{"id": "1b8b03eb-3518-54af-bcf4-4a59017eab1f", "code": "INF-BJN", "name": "Especialização em Informática na Educação", "duties": "", "callForm": "PUBLICATION", "locality": "Polo Bom Jesus do Norte", "workload": "480 horas", "description": "Curso de pós-graduação lato sensu, a distância, com encontros síncronos. Polo Bom Jesus do Norte.", "reserveType": "NONE", "compensation": "", "requirements": ["Diploma de curso superior de graduação (bacharelado, licenciatura ou tecnologia) reconhecido pelo MEC", "Acesso a computador com conexão à internet"], "reserveLimit": null, "vacancyTable": [{"id": "3da086ad-0aaf-5524-8f57-95972c846d4d", "modalityId": null, "immediateVacancies": 28}, {"id": "4058dc83-ebb0-5c84-af46-929883818e0c", "modalityId": "8cf90e09-38a8-5458-8422-3c757c443f46", "immediateVacancies": 10}, {"id": "b2506e92-79f2-58b5-b521-fea650c6af15", "modalityId": "04c71006-d70a-57a9-9cff-565e5ac1babd", "immediateVacancies": 2}], "declaredFacts": [], "callInformation": {}, "vacancyReversion": {"kind": "ON_EXHAUSTION"}, "immediateVacancies": 40, "competitionModalities": [{"id": "1b80c639-6665-58ca-8a56-090575f27e12", "code": "AC", "name": "Ampla concorrência", "description": "", "normativeRule": null}, {"id": "04c71006-d70a-57a9-9cff-565e5ac1babd", "code": "PcD", "name": "Pessoas com deficiência", "description": "", "normativeRule": {"id": "bd8be0cd-3476-5