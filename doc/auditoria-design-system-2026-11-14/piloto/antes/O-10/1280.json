{"blocos":[{"id":"b:2818717d:1","texto":"Ocupação de vagas","tag":"h1","classes":[],"visibilidade":"visivel","item":"pagina","caixa":[280,80,976,38]},{"id":"b:df01b935:1","texto":"Quantas vagas cada lista de concorrência publicou, quantas tem efetivamente, quantas estão ocupadas e quantas faltam.","tag":"p","classes":["sub"],"visibilidade":"visivel","item":"pagina","caixa":[280,122,685,48]},{"id":"b:fa7556f6:1","texto":"Termos desta tela","tag":"summary","classes":[],"visibilidade":"visivel","item":"recolhido:Termos desta tela","caixa":[280,194,134,31]},{"id":"b:fbf75a34:1","texto":"Recorte é a lista em que a pessoa concorre — a ampla concorrência, ou uma Modalidade de Concorrência declarada. Faixa é o trecho da ordem que um ato publicou — do primeiro colocado ao último que o alvo alcançou.","tag":"p","classes":["definicoes"],"visibilidade":"recolhido","item":"recolhido:Termos desta tela","caixa":[280,225,600,89]},{"id":"b:11784dcf:1","texto":"Apurar a ocupação deste marco depende da permissão de gerir a comissão ou da presidência deste Processo — cada uma basta sozinha. Peça a alguém com a permissão de gerir a comissão ou a quem preside este Processo que a apure. A presidência não é papel: ela vem da composição da comissão.","tag":"p","classes":["ajuda"],"visibilidade":"visivel","item":"pagina","caixa":[280,241,704,54]},{"id":"b:76d121f:1","texto":"Abrir esta tela não apura nada . Os números abaixo vêm de atos já emitidos, e onde não há ato não há número.","tag":"p","classes":["imutavel"],"visibilidade":"visivel","item":"pagina","caixa":[280,307,976,45]},{"id":"b:244c1049:1","texto":"Ampla concorrência (linha geral do quadro)","tag":"h2","classes":[],"visibilidade":"visivel","item":"recorte:Ampla concorrência (linha geral do quadro)","caixa":[280,368,976,28]},{"id":"b:88c49f27:1","texto":"3 Publicadas","tag":"li","classes":[],"visibilidade":"visivel","item":"recorte:Ampla concorrência (linha geral do quadro)","caixa":[280,412,100,69]},{"id":"b:2b2a26a6:1","texto":"3 Efetivas","tag":"li","classes":[],"visibilidade":"visivel","item":"recorte:Ampla concorrência (linha geral do quadro)","caixa":[388,412,80,69]},{"id":"b:24c82a7c:1","texto":"0 Ocupadas","tag":"li","classes":[],"visibilidade":"visivel","item":"recorte:Ampla concorrência (linha geral do quadro)","caixa":[476,412,95,69]},{"id":"b:9a007a9a:1","texto":"3 A ocupar","tag":"li","classes":[],"visibilidade":"visivel","item":"recorte:Ampla concorrência (linha geral do quadro)","caixa":[578,412,87,69]},{"id":"b:4627aaf9:1","texto":"Ver o histórico deste recorte","tag":"p","classes":["acoes"],"visibilidade":"visivel","item":"recorte:Ampla concorrência (linha geral do quadro)","caixa":[280,505,685,24]},{"id":"b:13255b18:1","texto":"Abrir a convocação deste recorte","tag":"p","classes":["acoes"],"visibilidade":"visivel","item":"recorte:Ampla concorrência (linha geral do quadro)","caixa":[280,545,685,24]},{"id":"b:cdcb843d:1","texto":"Pretos, pardos e indígenas (PPI)","tag":"h2","classes":[],"visibilidade":"visivel","item":"recorte:Pretos, pardos e indígenas (PPI)","caixa":[280,601,976,28]},{"id":"b:d1b1be30:1","texto":"Ocupação ainda não apurada.","tag":"p","classes":["aviso"],"visibilidade":"visivel","item":"recorte:Pretos, pardos e indígenas (PPI)","caixa":[280,645,976,48]},{"id":"b:7b1e1420:1","texto":"2 Publicadas","tag":"li","classes":[],"visibilidade":"visivel","item":"recorte:Pretos, pardos e indígenas (PPI)","caixa":[280,717,100,69]},{"id":"b:2bd1aa15:1","texto":"A quantidade publicada é o que o Edital declara nesta linha do quadro. Quantas estão ocupadas e quantas faltam só existem depois de uma apuração emitida.","tag":"p","classes":["nota"],"visibilidade":"visivel","item":"recorte:Pretos, pardos e indígenas (PPI)","caixa":[280,810,600,42]}],"quantidades":[{"numero":"3","rotulo":"# Publicadas","item":"recorte:Ampla concorrência (linha geral do quadro)"},{"numero":"3","rotulo":"# Efetivas","item":"recorte:Ampla concorrência (linha geral do quadro)"},{"numero":"0","rotulo":"# Ocupadas","item":"recorte:Ampla concorrência (linha geral do quadro)"},{"numero":"3","rotulo":"# A ocupar","item":"recorte:Ampla concorrência (linha geral do quadro)"},{"numero":"2","rotulo":"# Publicadas","item":"recorte:Pretos, pardos e indígenas (PPI)"},{"numero":"3","rotulo":"Publicadas","item":"recorte:Ampla concorrência (linha geral do quadro)","par":true},{"numero":"3","rotulo":"Efetivas","item":"recorte:Ampla concorrência (linha geral do quadro)","par":true},{"numero":"0","rotulo":"Ocupadas","item":"recorte:Ampla concorrência (linha geral do quadro)","par":true},{"numero":"3","rotulo":"A ocupar","item":"recorte:Ampla concorrência (linha geral do quadro)","par":true},{"numero":"2","rotulo":"Publicadas","item":"recorte:Pretos, pardos e indígenas (PPI)","par":true}],"acoes":[{"tipo":"link","rotulo":"Ver o histórico deste recorte","destino":"/gestao/editais/‹id›/marcos/‹id›/ocupacao/historico","item":"recorte:Ampla concorrência (linha geral do quadro)"},{"tipo":"link","rotulo":"Abrir a convocação deste recorte","destino":"/gestao/editais/‹id›/marcos/‹id›/convocacao","item":"recorte:Ampla concorrência (linha geral do quadro)"}],"ordem_documento":["b:2818717d:1","b:df01b935:1","b:fa7556f6:1","b:fbf75a34:1","b:11784dcf:1","b:76d121f:1","b:244c1049:1","b:88c49f27:1","b:2b2a26a6:1","b:24c82a7c:1","b:9a007a9a:1","b:4627aaf9:1","b:13255b18:1","b:cdcb843d:1","b:d1b1be30:1","b:7b1e1420:1","b:2bd1aa15:1"],"ordem_visual":["b:2818717d:1","b:df01b935:1","b:fa7556f6:1","b:11784dcf:1","b:76d121f:1","b:244c1049:1","b:88c49f27:1","b:2b2a26a6:1","b:24c82a7c:1","b:9a007a9a:1","b:4627aaf9:1","b:13255b18:1","b:cdcb843d:1","b:d1b1be30:1","b:7b1e1420:1","b:2bd1aa15:1"],"linhas":[{"bloco":"b:df01b935:1","maior_linha":90},{"bloco":"b:11784dcf:1","maior_linha":114},{"bloco":"b:76d121f:1","maior_linha":108},{"bloco":"b:2bd1aa15:1","maior_linha":84}],"rolagem_horizontal":false,"codigo":"O-10","largura":1280,"papel":"quem só lê","tela":"ocupacao","violacoes_de_csp":[]}