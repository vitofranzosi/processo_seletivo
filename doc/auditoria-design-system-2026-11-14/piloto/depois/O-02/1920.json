{"blocos":[{"id":"b:2818717d:1","texto":"Ocupação de vagas","tag":"h1","classes":[],"visibilidade":"visivel","item":"pagina","caixa":[344,80,1488,38]},{"id":"b:df01b935:1","texto":"Quantas vagas cada lista de concorrência publicou, quantas tem efetivamente, quantas estão ocupadas e quantas faltam.","tag":"p","classes":["sub"],"visibilidade":"visivel","item":"pagina","caixa":[344,122,544,48]},{"id":"b:fa7556f6:1","texto":"Termos desta tela","tag":"summary","classes":[],"visibilidade":"visivel","item":"recolhido:Termos desta tela","caixa":[344,190,134,31]},{"id":"b:fbf75a34:1","texto":"Recorte é a lista em que a pessoa concorre — a ampla concorrência, ou uma Modalidade de Concorrência declarada. Faixa é o trecho da ordem que um ato publicou — do primeiro colocado ao último que o alvo alcançou.","tag":"p","classes":["definicoes"],"visibilidade":"recolhido","item":"recolhido:Termos desta tela","caixa":[344,221,476,110]},{"id":"b:76d121f:1","texto":"Abrir esta tela não apura nada . Os números abaixo vêm de atos já emitidos, e onde não há ato não há número.","tag":"p","classes":["imutavel"],"visibilidade":"visivel","item":"pagina","caixa":[344,237,550,69]},{"id":"b:244c1049:1","texto":"Ampla concorrência (linha geral do quadro)","tag":"h2","classes":[],"visibilidade":"visivel","item":"recorte:Ampla concorrência (linha geral do quadro)","caixa":[361,335,1454,28]},{"id":"b:691c3c55:1","texto":"Este Edital não publicou quadro de vagas para este recorte. Não há quantidade declarada a apurar.","tag":"p","classes":["aviso"],"visibilidade":"visivel","item":"recorte:Ampla concorrência (linha geral do quadro)","caixa":[361,379,584,72]},{"id":"b:d545da30:1","texto":"A quantidade é declarada por Retificação do Perfil, acrescentando a linha deste recorte ao quadro de vagas: quem elabora Retificações é quem pode declará-la.","tag":"p","classes":["nota"],"visibilidade":"visivel","item":"recorte:Ampla concorrência (linha geral do quadro)","caixa":[361,463,476,63]}],"quantidades":[],"acoes":[],"ordem_documento":["b:2818717d:1","b:df01b935:1","b:fa7556f6:1","b:fbf75a34:1","b:76d121f:1","b:244c1049:1","b:691c3c55:1","b:d545da30:1"],"ordem_visual":["b:2818717d:1","b:df01b935:1","b:fa7556f6:1","b:76d121f:1","b:244c1049:1","b:691c3c55:1","b:d545da30:1"],"linhas":[{"bloco":"b:df01b935:1","maior_linha":62},{"bloco":"b:76d121f:1","maior_linha":65},{"bloco":"b:691c3c55:1","maior_linha":66},{"bloco":"b:d545da30:1","maior_linha":73}],"rolagem_horizontal":false,"codigo":"O-02","largura":1920,"papel":"quem emite e não retifica","tela":"ocupacao","violacoes_de_csp":[]}