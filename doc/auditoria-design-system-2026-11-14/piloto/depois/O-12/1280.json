{"blocos":[{"id":"b:2818717d:1","texto":"Ocupação de vagas","tag":"h1","classes":[],"visibilidade":"visivel","item":"pagina","caixa":[280,80,976,38]},{"id":"b:df01b935:1","texto":"Quantas vagas cada lista de concorrência publicou, quantas tem efetivamente, quantas estão ocupadas e quantas faltam.","tag":"p","classes":["sub"],"visibilidade":"visivel","item":"pagina","caixa":[280,122,976,24]},{"id":"b:fa7556f6:1","texto":"Termos desta tela","tag":"summary","classes":[],"visibilidade":"visivel","item":"recolhido:Termos desta tela","caixa":[280,166,134,31]},{"id":"b:fbf75a34:1","texto":"Recorte é a lista em que a pessoa concorre — a ampla concorrência, ou uma Modalidade de Concorrência declarada. Faixa é o trecho da ordem que um ato publicou — do primeiro colocado ao último que o alvo alcançou.","tag":"p","classes":["definicoes"],"visibilidade":"recolhido","item":"recolhido:Termos desta tela","caixa":[280,197,685,89]},{"id":"b:76d121f:1","texto":"Abrir esta tela não apura nada . Os números abaixo vêm de atos já emitidos, e onde não há ato não há número.","tag":"p","classes":["imutavel"],"visibilidade":"visivel","item":"pagina","caixa":[280,213,976,47]},{"id":"b:244c1049:1","texto":"Ampla concorrência (linha geral do quadro)","tag":"h2","classes":[],"visibilidade":"visivel","item":"recorte:Ampla concorrência (linha geral do quadro)","caixa":[297,285,942,28]},{"id":"b:aa2d77a5:1","texto":"1 Publicadas","tag":"li","classes":[],"visibilidade":"visivel","item":"recorte:Ampla concorrência (linha geral do quadro)","caixa":[297,329,227,69]},{"id":"b:6ae6c7a4:1","texto":"1 Efetivas","tag":"li","classes":[],"visibilidade":"visivel","item":"recorte:Ampla concorrência (linha geral do quadro)","caixa":[536,329,227,69]},{"id":"b:84e9d9fd:1","texto":"1 Ocupadas","tag":"li","classes":[],"visibilidade":"visivel","item":"recorte:Ampla concorrência (linha geral do quadro)","caixa":[774,329,227,69]},{"id":"b:799b6c17:1","texto":"0 A ocupar","tag":"li","classes":[],"visibilidade":"visivel","item":"recorte:Ampla concorrência (linha geral do quadro)","caixa":[1013,329,227,69]},{"id":"b:4627aaf9:1","texto":"Ver o histórico deste recorte","tag":"p","classes":["acoes"],"visibilidade":"visivel","item":"recorte:Ampla concorrência (linha geral do quadro)","caixa":[297,410,942,24]},{"id":"b:13255b18:1","texto":"Abrir a convocação deste recorte","tag":"p","classes":["acoes"],"visibilidade":"visivel","item":"recorte:Ampla concorrência (linha geral do quadro)","caixa":[297,442,942,24]},{"id":"b:7ba17623:1","texto":"Suceder esta apuração (exige motivo)","tag":"summary","classes":[],"visibilidade":"visivel","item":"recorte:Ampla concorrência (linha geral do quadro) > recolhido:Suceder esta apuração (exige motivo)","caixa":[297,491,290,34]},{"id":"b:f9ba6995:1","texto":"Motivo da nova apuração","tag":"label","classes":[],"visibilidade":"recolhido","item":"recorte:Ampla concorrência (linha geral do quadro) > recolhido:Suceder esta apuração (exige motivo) > form: > campo:","caixa":[297,550,942,20]},{"id":"b:609f826a:1","texto":"A apuração vigente não é alterada: a nova a sucede, e a anterior continua legível.","tag":"p","classes":["campo"],"visibilidade":"recolhido","item":"recorte:Ampla concorrência (linha geral do quadro) > recolhido:Suceder esta apuração (exige motivo) > form:","caixa":[297,550,942,127]},{"id":"b:b56ddbf4:1","texto":"Emitir nova apuração","tag":"button","classes":["botao"],"visibilidade":"recolhido","item":"recorte:Ampla concorrência (linha geral do quadro) > recolhido:Suceder esta apuração (exige motivo) > form:","caixa":[297,691,179,40]},{"id":"b:a83431ab:1","texto":"Pessoas com deficiência (PCD)","tag":"h2","classes":[],"visibilidade":"visivel","item":"recorte:Pessoas com deficiência (PCD)","caixa":[297,579,942,28]},{"id":"b:27780bf7:1","texto":"Ocupação ainda não apurada.","tag":"p","classes":["aviso"],"visibilidade":"visivel","item":"recorte:Pessoas com deficiência (PCD)","caixa":[297,622,942,48]},{"id":"b:8d5441c6:1","texto":"1 Publicadas","tag":"li","classes":[],"visibilidade":"visivel","item":"recorte:Pessoas com deficiência (PCD)","caixa":[297,686,942,69]},{"id":"b:acf3f9fc:1","texto":"A quantidade publicada é o que o Edital declara nesta linha do quadro. Quantas estão ocupadas e quantas faltam só existem depois de uma apuração emitida.","tag":"p","classes":["nota"],"visibilidade":"visivel","item":"recorte:Pessoas com deficiência (PCD)","caixa":[297,767,942,42]},{"id":"b:947e3b75:1","texto":"Apurar a ocupação deste recorte","tag":"button","classes":["botao"],"visibilidade":"visivel","item":"recorte:Pessoas com deficiência (PCD) > form:Apurar a ocupação deste recorte","caixa":[297,834,256,40]},{"id":"b:cdcb843d:1","texto":"Pretos, pardos e indígenas (PPI)","tag":"h2","classes":[],"visibilidade":"visivel","item":"recorte:Pretos, pardos e indígenas (PPI)","caixa":[297,912,942,28]},{"id":"b:7b0a5919:1","texto":"Esta apuração está obsoleta. O número abaixo é o que ela apurou, e o mundo mudou depois dela:","tag":"p","classes":["aviso"],"visibilidade":"visivel","item":"recorte:Pretos, pardos e indígenas (PPI)","caixa":[297,956,942,48]},{"id":"b:a343242f:1","texto":"um efeito registrado depois dela mudou o conjunto de ocupantes deste recorte","tag":"li","classes":[],"visibilidade":"visivel","item":"recorte:Pretos, pardos e indígenas (PPI)","caixa":[314,1037,908,23]},{"id":"b:d78f559f:1","texto":"1 Publicadas","tag":"li","classes":[],"visibilidade":"visivel","item":"recorte:Pretos, pardos e indígenas (PPI)","caixa":[297,1096,227,69]},{"id":"b:c921cade:1","texto":"1 Efetivas","tag":"li","classes":[],"visibilidade":"visivel","item":"recorte:Pretos, pardos e indígenas (PPI)","caixa":[536,1096,227,69]},{"id":"b:460469f7:1","texto":"1 Ocupadas","tag":"li","classes":[],"visibilidade":"visivel","item":"recorte:Pretos, pardos e indígenas (PPI)","caixa":[774,1096,227,69]},{"id":"b:f101b391:1","texto":"0 A ocupar","tag":"li","classes":[],"visibilidade":"visivel","item":"recorte:Pretos, pardos e indígenas (PPI)","caixa"