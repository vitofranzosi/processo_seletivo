{"blocos":[{"id":"b:2818717d:1","texto":"Ocupação de vagas","tag":"h1","classes":[],"visibilidade":"visivel","item":"pagina","caixa":[24,170,327,38]},{"id":"b:df01b935:1","texto":"Quantas vagas cada lista de concorrência publicou, quantas tem efetivamente, quantas estão ocupadas e quantas faltam.","tag":"p","classes":["sub"],"visibilidade":"visivel","item":"pagina","caixa":[24,212,327,72]},{"id":"b:fa7556f6:1","texto":"Termos desta tela","tag":"summary","classes":[],"visibilidade":"visivel","item":"recolhido:Termos desta tela","caixa":[24,304,134,31]},{"id":"b:fbf75a34:1","texto":"Recorte é a lista em que a pessoa concorre — a ampla concorrência, ou uma Modalidade de Concorrência declarada. Faixa é o trecho da ordem que um ato publicou — do primeiro colocado ao último que o alvo alcançou.","tag":"p","classes":["definicoes"],"visibilidade":"recolhido","item":"recolhido:Termos desta tela","caixa":[24,335,327,131]},{"id":"b:76d121f:1","texto":"Abrir esta tela não apura nada . Os números abaixo vêm de atos já emitidos, e onde não há ato não há número.","tag":"p","classes":["imutavel"],"visibilidade":"visivel","item":"pagina","caixa":[24,351,327,92]},{"id":"b:244c1049:1","texto":"Ampla concorrência (linha geral do quadro)","tag":"h2","classes":[],"visibilidade":"visivel","item":"recorte:Ampla concorrência (linha geral do quadro)","caixa":[41,468,293,55]},{"id":"b:aa2d77a5:1","texto":"1 Publicadas","tag":"li","classes":[],"visibilidade":"visivel","item":"recorte:Ampla concorrência (linha geral do quadro)","caixa":[41,539,293,69]},{"id":"b:6ae6c7a4:1","texto":"1 Efetivas","tag":"li","classes":[],"visibilidade":"visivel","item":"recorte:Ampla concorrência (linha geral do quadro)","caixa":[41,620,293,69]},{"id":"b:84e9d9fd:1","texto":"1 Ocupadas","tag":"li","classes":[],"visibilidade":"visivel","item":"recorte:Ampla concorrência (linha geral do quadro)","caixa":[41,701,293,69]},{"id":"b:799b6c17:1","texto":"0 A ocupar","tag":"li","classes":[],"visibilidade":"visivel","item":"recorte:Ampla concorrência (linha geral do quadro)","caixa":[41,782,293,69]},{"id":"b:4627aaf9:1","texto":"Ver o histórico deste recorte","tag":"p","classes":["acoes"],"visibilidade":"visivel","item":"recorte:Ampla concorrência (linha geral do quadro)","caixa":[41,863,293,24]},{"id":"b:13255b18:1","texto":"Abrir a convocação deste recorte","tag":"p","classes":["acoes"],"visibilidade":"visivel","item":"recorte:Ampla concorrência (linha geral do quadro)","caixa":[41,895,293,24]},{"id":"b:7ba17623:1","texto":"Suceder esta apuração (exige motivo)","tag":"summary","classes":[],"visibilidade":"visivel","item":"recorte:Ampla concorrência (linha geral do quadro) > recolhido:Suceder esta apuração (exige motivo)","caixa":[41,944,290,34]},{"id":"b:f9ba6995:1","texto":"Motivo da nova apuração","tag":"label","classes":[],"visibilidade":"recolhido","item":"recorte:Ampla concorrência (linha geral do quadro) > recolhido:Suceder esta apuração (exige motivo) > form: > campo:","caixa":[41,1003,293,20]},{"id":"b:609f826a:1","texto":"A apuração vigente não é alterada: a nova a sucede, e a anterior continua legível.","tag":"p","classes":["campo"],"visibilidade":"recolhido","item":"recorte:Ampla concorrência (linha geral do quadro) > recolhido:Suceder esta apuração (exige motivo) > form:","caixa":[41,1003,293,145]},{"id":"b:b56ddbf4:1","texto":"Emitir nova apuração","tag":"button","classes":["botao"],"visibilidade":"recolhido","item":"recorte:Ampla concorrência (linha geral do quadro) > recolhido:Suceder esta apuração (exige motivo) > form:","caixa":[41,1162,179,40]},{"id":"b:a83431ab:1","texto":"Pessoas com deficiência (PCD)","tag":"h2","classes":[],"visibilidade":"visivel","item":"recorte:Pessoas com deficiência (PCD)","caixa":[41,1032,293,28]},{"id":"b:27780bf7:1","texto":"Ocupação ainda não apurada.","tag":"p","classes":["aviso"],"visibilidade":"visivel","item":"recorte:Pessoas com deficiência (PCD)","caixa":[41,1076,293,48]},{"id":"b:8d5441c6:1","texto":"1 Publicadas","tag":"li","classes":[],"visibilidade":"visivel","item":"recorte:Pessoas com deficiência (PCD)","caixa":[41,1140,293,69]},{"id":"b:acf3f9fc:1","texto":"A quantidade publicada é o que o Edital declara nesta linha do quadro. Quantas estão ocupadas e quantas faltam só existem depois de uma apuração emitida.","tag":"p","classes":["nota"],"visibilidade":"visivel","item":"recorte:Pessoas com deficiência (PCD)","caixa":[41,1221,293,84]},{"id":"b:947e3b75:1","texto":"Apurar a ocupação deste recorte","tag":"button","classes":["botao"],"visibilidade":"visivel","item":"recorte:Pessoas com deficiência (PCD) > form:Apurar a ocupação deste recorte","caixa":[41,1330,256,40]},{"id":"b:cdcb843d:1","texto":"Pretos, pardos e indígenas (PPI)","tag":"h2","classes":[],"visibilidade":"visivel","item":"recorte:Pretos, pardos e indígenas (PPI)","caixa":[41,1408,293,28]},{"id":"b:7b0a5919:1","texto":"Esta apuração está obsoleta. O número abaixo é o que ela apurou, e o mundo mudou depois dela:","tag":"p","classes":["aviso"],"visibilidade":"visivel","item":"recorte:Pretos, pardos e indígenas (PPI)","caixa":[41,1451,293,96]},{"id":"b:a343242f:1","texto":"um efeito registrado depois dela mudou o conjunto de ocupantes deste recorte","tag":"li","classes":[],"visibilidade":"visivel","item":"recorte:Pretos, pardos e indígenas (PPI)","caixa":[58,1580,259,68]},{"id":"b:d78f559f:1","texto":"1 Publicadas","tag":"li","classes":[],"visibilidade":"visivel","item":"recorte:Pretos, pardos e indígenas (PPI)","caixa":[41,1685,293,69]},{"id":"b:c921cade:1","texto":"1 Efetivas","tag":"li","classes":[],"visibilidade":"visivel","item":"recorte:Pretos, pardos e indígenas (PPI)","caixa":[41,1766,293,69]},{"id":"b:460469f7:1","texto":"1 Ocupadas","tag":"li","classes":[],"visibilidade":"visivel","item":"recorte:Pretos, pardos e indígenas (PPI)","caixa":[41,1847,293,69]},{"id":"b:f101b391:1","texto":"0 A ocupar","tag":"li","classes":[],"visibilidade":"visivel","item":"recorte:Pretos, pardos e indígenas (PPI)","caixa":[41,1928,293,69