{"blocos":[{"id":"b:2818717d:1","texto":"Ocupação de vagas","tag":"h1","classes":[],"visibilidade":"visivel","item":"pagina","caixa":[280,80,1136,38]},{"id":"b:df01b935:1","texto":"Quantas vagas cada lista de concorrência publicou, quantas tem efetivamente, quantas estão ocupadas e quantas faltam.","tag":"p","classes":["sub"],"visibilidade":"visivel","item":"pagina","caixa":[280,122,1136,24]},{"id":"b:fa7556f6:1","texto":"Termos desta tela","tag":"summary","classes":[],"visibilidade":"visivel","item":"recolhido:Termos desta tela","caixa":[280,166,134,31]},{"id":"b:fbf75a34:1","texto":"Recorte é a lista em que a pessoa concorre — a ampla concorrência, ou uma Modalidade de Concorrência declarada. Faixa é o trecho da ordem que um ato publicou — do primeiro colocado ao último que o alvo alcançou.","tag":"p","classes":["definicoes"],"visibilidade":"recolhido","item":"recolhido:Termos desta tela","caixa":[280,197,685,89]},{"id":"b:aeebfe83:1","texto":"Faixa seguinte emitida com o déficit apurado como causa. A faixa anterior não foi revogada, e quem já progrediu continua nela.","tag":"p","classes":["sucesso"],"visibilidade":"visivel","item":"pagina","caixa":[280,213,1136,48]},{"id":"b:900c33a:1","texto":"Próximo nesta lista: Distribuir 3 inscrições sem avaliador suficiente .","tag":"p","classes":["proximo-nesta-lista"],"visibilidade":"visivel","item":"pagina","caixa":[280,273,1136,24]},{"id":"b:abcc7fb9:1","texto":"Voltar ao Centro de Controle do Edital","tag":"p","classes":["retorno-ao-centro"],"visibilidade":"visivel","item":"pagina","caixa":[280,301,1136,24]},{"id":"b:76d121f:1","texto":"Abrir esta tela não apura nada . Os números abaixo vêm de atos já emitidos, e onde não há ato não há número.","tag":"p","classes":["imutavel"],"visibilidade":"visivel","item":"pagina","caixa":[280,337,1136,47]},{"id":"b:244c1049:1","texto":"Ampla concorrência (linha geral do quadro)","tag":"h2","classes":[],"visibilidade":"visivel","item":"recorte:Ampla concorrência (linha geral do quadro)","caixa":[297,409,1102,28]},{"id":"b:88c49f27:1","texto":"3 Publicadas","tag":"li","classes":[],"visibilidade":"visivel","item":"recorte:Ampla concorrência (linha geral do quadro)","caixa":[297,453,267,69]},{"id":"b:2b2a26a6:1","texto":"3 Efetivas","tag":"li","classes":[],"visibilidade":"visivel","item":"recorte:Ampla concorrência (linha geral do quadro)","caixa":[576,453,267,69]},{"id":"b:24c82a7c:1","texto":"0 Ocupadas","tag":"li","classes":[],"visibilidade":"visivel","item":"recorte:Ampla concorrência (linha geral do quadro)","caixa":[854,453,267,69]},{"id":"b:9a007a9a:1","texto":"3 A ocupar","tag":"li","classes":[],"visibilidade":"visivel","item":"recorte:Ampla concorrência (linha geral do quadro)","caixa":[1133,453,267,69]},{"id":"b:4627aaf9:1","texto":"Ver o histórico deste recorte","tag":"p","classes":["acoes"],"visibilidade":"visivel","item":"recorte:Ampla concorrência (linha geral do quadro)","caixa":[297,534,1102,24]},{"id":"b:13255b18:1","texto":"Abrir a convocação deste recorte","tag":"p","classes":["acoes"],"visibilidade":"visivel","item":"recorte:Ampla concorrência (linha geral do quadro)","caixa":[297,566,1102,24]},{"id":"b:7ba17623:1","texto":"Suceder esta apuração (exige motivo)","tag":"summary","classes":[],"visibilidade":"visivel","item":"recorte:Ampla concorrência (linha geral do quadro) > recolhido:Suceder esta apuração (exige motivo)","caixa":[297,615,290,34]},{"id":"b:f9ba6995:1","texto":"Motivo da nova apuração","tag":"label","classes":[],"visibilidade":"recolhido","item":"recorte:Ampla concorrência (linha geral do quadro) > recolhido:Suceder esta apuração (exige motivo) > form: > campo:","caixa":[297,674,1102,20]},{"id":"b:609f826a:1","texto":"A apuração vigente não é alterada: a nova a sucede, e a anterior continua legível.","tag":"p","classes":["campo"],"visibilidade":"recolhido","item":"recorte:Ampla concorrência (linha geral do quadro) > recolhido:Suceder esta apuração (exige motivo) > form:","caixa":[297,674,1102,127]},{"id":"b:b56ddbf4:1","texto":"Emitir nova apuração","tag":"button","classes":["botao"],"visibilidade":"recolhido","item":"recorte:Ampla concorrência (linha geral do quadro) > recolhido:Suceder esta apuração (exige motivo) > form:","caixa":[297,815,179,40]},{"id":"b:ed42157b:1","texto":"O déficit apurado de 3 vaga(s) será a causa do ato, e a faixa anterior não é revogada.","tag":"p","classes":["ajuda"],"visibilidade":"visivel","item":"recorte:Ampla concorrência (linha geral do quadro) > form:Pedir a faixa seguinte com este déficit","caixa":[297,682,481,24]},{"id":"b:218288e4:1","texto":"Pedir a faixa seguinte com este déficit","tag":"button","classes":["botao"],"visibilidade":"visivel","item":"recorte:Ampla concorrência (linha geral do quadro) > form:Pedir a faixa seguinte com este déficit","caixa":[784,678,290,40]}],"quantidades":[{"numero":"3","rotulo":"Próximo nesta lista: Distribuir # inscrições sem avaliador suficiente .","item":"pagina"},{"numero":"3","rotulo":"# Publicadas","item":"recorte:Ampla concorrência (linha geral do quadro)"},{"numero":"3","rotulo":"# Efetivas","item":"recorte:Ampla concorrência (linha geral do quadro)"},{"numero":"0","rotulo":"# Ocupadas","item":"recorte:Ampla concorrência (linha geral do quadro)"},{"numero":"3","rotulo":"# A ocupar","item":"recorte:Ampla concorrência (linha geral do quadro)"},{"numero":"3","rotulo":"O déficit apurado de # vaga(s) será a causa do ato, e a faixa anterior não é revogada.","item":"recorte:Ampla concorrência (linha geral do quadro) > form:Pedir a faixa seguinte com este déficit"},{"numero":"3","rotulo":"Publicadas","item":"recorte:Ampla concorrência (linha geral do quadro)","par":true},{"numero":"3","rotulo":"Efetivas","item":"recorte:Ampla concorrência (linha geral do quadro)","par":true},{"numero":"0","rotulo":"Ocupadas","item":"recorte:Ampla concorrência (linha geral do quadro)","par":true},{"numero":"3","rotulo":"A ocupar","item":"recorte:Ampla concorrência (linha geral do quadro)","par":true}],"acoes":[{"tipo":"l