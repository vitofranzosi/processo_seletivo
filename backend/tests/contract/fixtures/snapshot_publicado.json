      "order": 7,
      "type": "GENERATED",
      "source": "stages"
    },
    {
      "id": "8d63ea40-e905-54d3-9630-abc0a1941559",
      "key": "classificacao",
      "title": "Critérios de Classificação",
      "order": 8,
      "type": "TEXT",
      "content": "A classificação observará a pontuação obtida nas Etapas de Avaliação, respeitados os pesos e as notas mínimas declarados neste Edital e as reservas de vaga previstas."
    },
    {
      "id": "96de1f8b-6d8f-5508-9768-41df9b976d50",
      "key": "cronograma",
      "title": "Cronograma",
      "order": 9,
      "type": "GENERATED",
      "source": "schedule"
    },
    {
      "id": "758beb06-c278-520b-9d92-35d4d8473d4b",
      "key": "recursos",
      "title": "Dos Recursos",
      "order": 10,
      "type": "TEXT",
      "content": "Caberá recurso contra o resultado de cada etapa, no prazo de 2 (dois) dias úteis contados da divulgação, exclusivamente pelo sistema.\nO recurso deve ser fundamentado e não pode conter identificação do candidato, sob pena de indeferimento liminar."
    },
    {
      "id": "add4303f-9e28-504b-a152-782961686189",
