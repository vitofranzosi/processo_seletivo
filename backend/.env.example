DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,testserver
DB_NAME=processo_seletivo
DB_ROLE=runtime
DB_RUNTIME_USER=processo_seletivo_runtime
DB_RUNTIME_PASSWORD=change-me
DB_MIGRATION_USER=processo_seletivo_owner
DB_MIGRATION_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432

# Produção (config.settings.production). O módulo se recusa a iniciar sem estes valores:
# a segurança de um sistema que publica atos normativos não pode depender de lembrar de exportar
# uma variável. Gere a chave com `python -c "from django.core.management.utils import
# get_random_secret_key as g; print(g())"`.
API_AUTHENTICATION_CLASSES=
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=true
DJANGO_SECURE_HSTS_PRELOAD=true
# Ligue apenas quando houver proxy institucional terminando o TLS.
DJANGO_TRUST_PROXY_SSL_HEADER=false
