# Copie para `backend/.env` e ajuste. O arquivo é ignorado pelo git.
#
# **Quem lê este arquivo.** O `docker compose` lê, e é a razão de ele existir com este nome e neste
# lugar: `compose.yaml` o declara como `env_file` dos dois serviços. A execução nativa **não lê** —
# nada no projeto carrega `.env` sozinho, e por isso o `make` do backend o carrega explicitamente
# (`make runserver`, `make migrate`, `make provisionar`). Um `manage.py` chamado à mão fora do
# `make` continua enxergando só o que estiver exportado no ambiente.

# --- Django ---------------------------------------------------------------------------------
# `DJANGO_SETTINGS_MODULE` **não** entra aqui, e a ausência é deliberada: `manage.py` já cai em
# `config.settings.development` sozinho, e o pytest-django dá precedência à variável de ambiente
# sobre o `pyproject.toml` — declará-la faria a suíte inteira rodar com as settings erradas.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
# `localhost` e não `127.0.0.1`: o padrão de `ALLOWED_HOSTS` é só `localhost`, e um endereço fora
# da lista devolve `DisallowedHost` antes de qualquer view.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# --- Banco ----------------------------------------------------------------------------------
# O projeto separa a role de migração da de runtime: a de runtime não recebe `UPDATE` nem `DELETE`
# sobre os registros append-only. `manage.py provisionar_papeis` cria as duas e aplica a política;
# ele precisa de um papel que possa criar papéis, e é por isso que o superusuário aparece abaixo.
DB_NAME=processo_seletivo
DB_ROLE=runtime
DB_RUNTIME_USER=processo_seletivo_runtime
DB_RUNTIME_PASSWORD=change-me
DB_MIGRATION_USER=processo_seletivo_owner
DB_MIGRATION_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432

# O mesmo banco visto do outro lado: estas três variáveis são do container do PostgreSQL, e o
# `compose.yaml` as entrega a ele. `POSTGRES_DB` precisa ser igual a `DB_NAME` — são o mesmo banco,
# nomeado por quem o cria e por quem se conecta a ele.
# Na execução nativa elas não fazem nada, e o superusuário é o da instalação local (no PostgreSQL
# instalado por Homebrew, normalmente o seu próprio usuário do sistema).
POSTGRES_DB=processo_seletivo
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

# --- Identidade -----------------------------------------------------------------------------
# Enquanto o diretório institucional não está integrado, dois substitutos de demonstração ocupam o
# lugar dele. Sem o primeiro, `/gestao/` não abre. Sem o segundo, o portal do candidato não
# autentica. **Os dois deixam qualquer pessoa declarar quem é**, e `config.settings.production`
# recusa iniciar com qualquer um deles ligado.
INTERFACE_SELETOR_IDENTIDADE=true
PORTAL_IDENTIDADE_DEMO=true

# --- Correio --------------------------------------------------------------------------------
# O portal envia código de acesso por e-mail. O backend de console **imprime a mensagem no
# terminal do servidor** — é onde o código aparece em desenvolvimento.
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=nao-responda@exemplo.test
PORTAL_ATENDIMENTO=selecao@exemplo.test
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_USE_TLS=false

# --- Documentos do candidato ----------------------------------------------------------------
# Raiz privada, fora da árvore do código e nunca servida pelo servidor web: todo acesso passa pela
# aplicação, que confere titularidade. Vazia significa "esta máquina não recebe arquivo".
# No compose ela é um volume e o `compose.yaml` sobrescreve este valor.
ARQUIVOS_CANDIDATOS_RAIZ=/tmp/ps-arquivos

# --- Suíte de testes ------------------------------------------------------------------------
# A suíte roda em SQLite por padrão e **pula calada** os testes que exigem garantias reais do
# banco. Para executar tudo é preciso o par: sem `TEST_DB_ENGINE=postgresql` ela cai para SQLite,
# e sem `DB_USER` ela tenta se conectar como a role de runtime, que não pode criar banco de teste.
TEST_DB_ENGINE=
DB_USER=
DB_PASSWORD=

# --- Produção -------------------------------------------------------------------------------
# `config.settings.production` trata cada uma como precondição de inicialização e recusa subir sem
# elas. Nenhuma tem efeito em desenvolvimento. Gere a chave com
# `python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"`.
API_AUTHENTICATION_CLASSES=
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=true
DJANGO_SECURE_HSTS_PRELOAD=true
# Ligue apenas quando houver proxy institucional terminando o TLS.
DJANGO_TRUST_PROXY_SSL_HEADER=false
PORTAL_ATRAS_DE_PROXY=false
